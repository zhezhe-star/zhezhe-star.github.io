---
import type { Project } from "@/data/projects";
import { visibilityLabel } from "@/data/projects";

type Props = {
  project: Project;
  compact?: boolean;
};

const { project, compact = false } = Astro.props;

const categoryLabel = {
  ai: "AI & Agent",
  product: "产品 & 工具",
  language: "语言学习",
}[project.category];
---

<article
  class="group border-border bg-background hover:border-accent/50 flex h-full flex-col overflow-hidden rounded-2xl border transition-colors"
>
  <div
    class="border-border bg-muted relative aspect-[16/10] overflow-hidden border-b"
  >
    <img
      src={project.cover}
      alt={project.coverAlt}
      width="1200"
      height="750"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
    <span
      class="bg-background/85 text-foreground absolute top-3 left-3 rounded-full px-2.5 py-1 text-[11px] font-medium backdrop-blur"
    >
      {visibilityLabel[project.visibility]}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p
          class="text-accent text-[11px] font-semibold tracking-[0.14em] uppercase"
        >
          {categoryLabel}
        </p>
        <h3 class="mt-1 text-xl font-semibold tracking-tight">
          {project.name}
        </h3>
      </div>
      <span class="text-muted-foreground shrink-0 text-xs">{project.year}</span>
    </div>

    <p class="text-muted-foreground mt-2 text-sm leading-6">
      {project.tagline}
    </p>

    {!compact && <p class="mt-3 text-sm leading-6">{project.description}</p>}

    <ul class="mt-4 space-y-2">
      {
        (compact ? project.highlights.slice(0, 3) : project.highlights).map(
          highlight => (
            <li class="flex gap-2.5 text-sm leading-6">
              <span class="bg-accent mt-[9px] size-1.5 shrink-0 rounded-full" />
              <span>{highlight}</span>
            </li>
          )
        )
      }
    </ul>

    <div class="mt-4 flex flex-wrap gap-2">
      {
        project.tags.map(tag => (
          <span class="border-border text-muted-foreground rounded-full border px-2.5 py-1 text-[11px]">
            {tag}
          </span>
        ))
      }
    </div>

    <div class="mt-auto pt-5">
      {
        project.links.length > 0 ? (
          <div class="flex flex-wrap gap-2">
            {project.links.map(link => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-accent text-accent-foreground inline-flex items-center gap-1 rounded-lg px-3.5 py-2 text-xs font-medium transition-opacity hover:opacity-90"
              >
                {link.label} ↗
              </a>
            ))}
          </div>
        ) : (
          <span class="text-muted-foreground text-xs">
            {project.note ?? "暂未公开"}
          </span>
        )
      }
    </div>
  </div>
</article>
