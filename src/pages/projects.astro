---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/projects";

const publicCount = projects.filter(p => p.visibility === "public").length;
const aiCount = projects.filter(p => p.category === "ai").length;
---

<Layout
  title="项目 | Zhe 的博客"
  description="Zhe 目前对外展示的项目：AgentVault、Football Fans 和 WordMem。"
>
  <Header />

  <main id="main-content" class="app-layout my-1">
    <section class="border-border border-b pt-8 pb-8">
      <p class="text-accent text-xs font-semibold tracking-[0.18em] uppercase">
        Personal Projects
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        做过的东西
      </h1>
      <p class="text-muted-foreground mt-4 max-w-2xl leading-7">
        这里是我目前对外展示的三个项目。其他还在进行中的项目，等稳定后再放上来。
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <span
          class="border-border bg-background rounded-full border px-3.5 py-1.5 text-xs"
        >
          <strong class="text-accent font-semibold">{projects.length}</strong>
          个项目
        </span>
        <span
          class="border-border bg-background rounded-full border px-3.5 py-1.5 text-xs"
        >
          <strong class="text-accent font-semibold">{publicCount}</strong>
          个开源
        </span>
        <span
          class="border-border bg-background rounded-full border px-3.5 py-1.5 text-xs"
        >
          <strong class="text-accent font-semibold">{aiCount}</strong>
          个 AI / Agent 方向
        </span>
      </div>
    </section>

    <section class="py-8">
      <div class="grid items-stretch gap-5 lg:grid-cols-2">
        {projects.map(project => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="pb-10">
      <div
        class="border-border bg-muted/40 rounded-2xl border p-6 sm:flex sm:items-center sm:justify-between sm:p-8"
      >
        <div>
          <h2 class="text-xl font-semibold">想聊某个项目？</h2>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            对项目细节、实现方式或合作感兴趣，可以在 GitHub 上找到我。
          </p>
        </div>
        <a
          href="https://github.com/zhezhe-star"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-accent text-accent-foreground mt-4 inline-flex items-center gap-1 rounded-lg px-4 py-2 text-sm font-medium sm:mt-0"
        >
          GitHub ↗
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
