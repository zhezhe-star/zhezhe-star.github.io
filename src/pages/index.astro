---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { featuredProjects } from "@/data/projects";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

const pillars = [
  {
    index: "01",
    title: "三寸工程师",
    body: "对“三寸”有些认知，关注技术里的深度与分寸。",
  },
  {
    index: "02",
    title: "创业 × 直播",
    body: "能做创业，但以稳定直播为主；既能从 0 到 1，也能长期经营。",
  },
  {
    index: "03",
    title: "AI Agent",
    body: "非常关注 Agent 的体验与安全：好不好用，以及能不能放心用。",
  },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-8 sm:text-5xl">
        我是 Zhe，<span class="block sm:inline">一个三寸工程师 👋</span>
      </h1>{" "}
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        对“三寸”有些认知。能做创业，但以稳定直播为主；现在非常关注 AI Agent
        的体验和安全。
      </p>
      <p class="mt-2">
        这里放我做过的东西，也放我写下的文章。可以从{" "}
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "projects")}
        >
          项目
        </LinkButton>{" "}
        或{" "}
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "posts")}
        >
          文章
        </LinkButton>{" "}
        开始，也可以去{" "}
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "about")}
        >
          关于
        </LinkButton>{" "}
        页面认识我。
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <section id="focus" class="border-border border-b py-8">
      <div class="grid gap-4 sm:grid-cols-3">
        {
          pillars.map(pillar => (
            <div class="border-border bg-background rounded-xl border p-5">
              <div class="text-accent text-[11px] font-semibold tracking-[0.16em]">
                {pillar.index}
              </div>
              <h2 class="mt-2 text-base font-semibold">{pillar.title}</h2>
              <p class="text-muted-foreground mt-2 text-sm leading-6">
                {pillar.body}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    {
      featuredProjects.length > 0 && (
        <section
          id="featured-projects"
          class="border-border border-b pt-12 pb-8"
        >
          <div class="flex items-end justify-between gap-4">
            <div>
              <h2 class="text-2xl font-semibold tracking-wide">
                {t.home.featuredProjects}
              </h2>
              <p class="text-muted-foreground mt-1 text-sm">
                AI Agent、效率工具和语言学习产品。
              </p>
            </div>
            <LinkButton
              class="hover:text-accent shrink-0 text-sm"
              href={getRelativeLocaleUrl(locale, "projects")}
            >
              {t.home.allProjects} →
            </LinkButton>
          </div>

          <div class="mt-6 grid items-stretch gap-5 md:grid-cols-2">
            {featuredProjects.map(project => (
              <ProjectCard project={project} compact />
            ))}
          </div>
        </section>
      )
    }

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
